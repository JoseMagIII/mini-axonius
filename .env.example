# Copy to .env and fill in. The app runs without these, but chat and the risk summary need Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Optional: raises the NVD rate limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=

DATABASE_URL=postgresql://admin:acme-admin@localhost:5544/assets
READER_PASSWORD=acme-reader
